# Copy to /mnt/user/appdata/arf/.env on Unraid and replace placeholders.

ARF_SOURCE_DIR=/mnt/user/appdata/arf/source
ARF_APPDATA_DIR=/mnt/user/appdata/arf

APP_BASE_URL=https://arf.kurue.com
SOURCE_CODE_URL=https://github.com/KuRue/ARF

ARF_POSTGRES_DB=arf
ARF_POSTGRES_USER=arf
ARF_POSTGRES_PASSWORD=replace-with-long-random-db-password

SESSION_SECRET=replace-with-long-random-session-secret
ARF_ADMIN_TELEGRAM_IDS=123456789

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=arf_bot
TELEGRAM_GROUP_ID=replace-with-telegram-group-id
TELEGRAM_WEBAPP_URL=https://arf.kurue.com/mini-app

TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
