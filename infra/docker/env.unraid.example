# Copy to /mnt/user/appdata/cego/.env on Unraid and replace placeholders.

CEGO_SOURCE_DIR=/mnt/user/appdata/cego/source
CEGO_APPDATA_DIR=/mnt/user/appdata/cego

APP_BASE_URL=https://cego.example.com
SOURCE_CODE_URL=https://github.com/KuRue/cego

CEGO_POSTGRES_DB=cego
CEGO_POSTGRES_USER=cego
CEGO_POSTGRES_PASSWORD=replace-with-long-random-db-password

SESSION_SECRET=replace-with-long-random-session-secret
CEGO_TASK_SECRET=replace-with-long-random-task-secret
CEGO_DEADLINE_WORKER_INTERVAL_SECONDS=60
CEGO_ADMIN_TELEGRAM_IDS=123456789

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=cego_bot
TELEGRAM_GROUP_ID=replace-with-telegram-group-id
TELEGRAM_WEBAPP_URL=https://cego.example.com/mini-app

TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
